# Copy to backend/.env and fill in. docker compose reads this file directly, so
# it must exist before `docker compose up` -- compose errors out if env_file is
# missing rather than starting with blank credentials.
#
#   cp backend/.env.example backend/.env

# From the LiveKit Cloud dashboard: Settings -> Keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Must match the agent_name the worker registers under. The token router asks
# LiveKit to dispatch this exact name into the room, so a mismatch means the
# call connects and no agent ever joins.
LIVEKIT_AGENT_NAME=assistant-1-ge-1
